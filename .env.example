# Archive-capable public RPC — also serves the pinned-block fork test (arb1.arbitrum.io
# resolves inconsistently in sandboxes and most public nodes reject archive reads).
ARBITRUM_RPC_URL="https://arbitrum-one.public.blastapi.io"
BASE_RPC_URL="https://mainnet.base.org"
# Testnet dress-rehearsal chain (Task 4a)
ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
# Foundry keystore account name for deploys/keeper txs (cast wallet list) — never a raw key.
KEYSTORE_ACCOUNT=""
# Optional: Etherscan v2 key (covers Arbitrum One + Arbitrum Sepolia) for the Arbiscan
# verified badge via `make verify-*`. Sourcify verification needs no key.
ETHERSCAN_API_KEY=""
